rules_version = '2';

// ===========================================
// RelayDesk
// storage.rules
// Firebase Storage — chat image attachments
// ===========================================
//
// Chat uploads now use the same lightweight Firebase Auth session that
// auth.js creates after the existing employee-code + PIN/password login
// succeeds. No Google/Gmail sign-in is required, but Storage no longer
// has to stay public for signed-in app users.
service firebase.storage {
  match /b/{bucket}/o {

    // Chat image attachments (chat.js) — one object per message, at
    // chatImages/{chatId}/{messageId}.{ext}. Firestore only ever
    // stores the resulting download URL; the bytes live here.
    match /chatImages/{chatId}/{fileName} {
      allow read, write: if request.auth != null;
    }
  }
}
